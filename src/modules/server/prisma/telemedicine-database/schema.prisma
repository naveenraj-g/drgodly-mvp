  @@index([referenceRangeId])
}

model ObservationHasMember {
  id            Int     @id @default(autoincrement())
  observationId String
  orgId         String?

  referenceType    String?
  referenceId      Int?
  referenceDisplay String?

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
}

model ObservationDerivedFrom {
  id            Int     @id @default(autoincrement())
  observationId String
  orgId         String?

  referenceType    String?
  referenceId      Int?
  referenceDisplay String?

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
}

model ObservationComponent {
  id            Int     @id @default(autoincrement())
  observationId String
  orgId         String?

  // code (CodeableConcept — required)
  codeSystem  String?
  codeCode    String?
  codeDisplay String?
  codeText    String?

  // value[x] — same variants as Observation.value[x]
  valueQuantityValue              Decimal?
  valueQuantityComparator         String?
  valueQuantityUnit               String?
  valueQuantitySystem             String?
  valueQuantityCode               String?
  valueCodeableConceptSystem      String?
  valueCodeableConceptCode        String?
  valueCodeableConceptDisplay     String?
  valueCodeableConceptText        String?
  valueString                     String?
  valueBoolean                    Boolean?
  valueInteger                    Int?
  valueTime                       String?
  valueDateTime                   DateTime?
  valuePeriodStart                DateTime?
  valuePeriodEnd                  DateTime?
  valueRangeLowValue              Decimal?
  valueRangeLowUnit               String?
  valueRangeLowSystem             String?
  valueRangeLowCode               String?
  valueRangeHighValue             Decimal?
  valueRangeHighUnit              String?
  valueRangeHighSystem            String?
  valueRangeHighCode              String?
  valueRatioNumeratorValue        Decimal?
  valueRatioNumeratorComparator   String?
  valueRatioNumeratorUnit         String?
  valueRatioNumeratorSystem       String?
  valueRatioNumeratorCode         String?
  valueRatioDenominatorValue      Decimal?
  valueRatioDenominatorComparator String?
  valueRatioDenominatorUnit       String?
  valueRatioDenominatorSystem     String?
  valueRatioDenominatorCode       String?
  valueSampledDataOriginValue     Decimal?
  valueSampledDataOriginUnit      String?
  valueSampledDataOriginSystem    String?
  valueSampledDataOriginCode      String?
  valueSampledDataPeriod          Decimal?
  valueSampledDataFactor          Decimal?
  valueSampledDataLowerLimit      Decimal?
  valueSampledDataUpperLimit      Decimal?
  valueSampledDataDimensions      Int?
  valueSampledDataData            String?

  // dataAbsentReason (CodeableConcept)
  dataAbsentReasonSystem  String?
  dataAbsentReasonCode    String?
  dataAbsentReasonDisplay String?
  dataAbsentReasonText    String?

  observation     Observation                          @relation(fields: [observationId], references: [id], onDelete: Cascade)
  interpretations ObservationComponentInterpretation[]
  referenceRanges ObservationComponentReferenceRange[]

  @@index([observationId])
}

model ObservationComponentInterpretation {
  id          Int     @id @default(autoincrement())
  componentId Int
  orgId       String?

  codingSystem  String?
  codingCode    String?
  codingDisplay String?
  text          String?

  component ObservationComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

model ObservationComponentReferenceRange {
  id          Int     @id @default(autoincrement())
  componentId Int
  orgId       String?

  lowValue  Decimal?
  lowUnit   String?
  lowSystem String?
  lowCode   String?

  highValue  Decimal?
  highUnit   String?
  highSystem String?
  highCode   String?

  typeSystem  String?
  typeCode    String?
  typeDisplay String?
  typeText    String?

  ageLowValue   Decimal?
  ageLowUnit    String?
  ageLowSystem  String?
  ageLowCode    String?
  ageHighValue  Decimal?
  ageHighUnit   String?
  ageHighSystem String?
  ageHighCode   String?

  text String?

  component ObservationComponent                          @relation(fields: [componentId], references: [id], onDelete: Cascade)
  appliesTo ObservationComponentReferenceRangeAppliesTo[]

  @@index([componentId])
}

model ObservationComponentReferenceRangeAppliesTo {
  id               Int     @id @default(autoincrement())
  referenceRangeId Int
  orgId            String?

  codingSystem  String?
  codingCode    String?
  codingDisplay String?
  text          String?

  referenceRange ObservationComponentReferenceRange @relation(fields: [referenceRangeId], references: [id], onDelete: Cascade)

  @@index([referenceRangeId])
}

// ───────────────────────────────────────────────────────────────
// CONDITION
// ───────────────────────────────────────────────────────────────

model Condition {
  id    String @id @default(uuid())
  orgId String

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // clinicalStatus (CodeableConcept)
  clinicalStatusSystem  String?
  clinicalStatusCode    String?
  clinicalStatusDisplay String?
  clinicalStatusText    String?

  // verificationStatus (CodeableConcept)
  verificationStatusSystem  String?
  verificationStatusCode    String?
  verificationStatusDisplay String?
  verificationStatusText    String?

  // severity (CodeableConcept)
  severitySystem  String?
  severityCode    String?
  severityDisplay String?
  severityText    String?

  // code (CodeableConcept)
  codeSystem  String?
  codeCode    String?
  codeDisplay String?
  codeText    String?

  // subject (Reference)
  subjectType    String?
  subjectId      Int?
  subjectDisplay String?

  // onset[x]
  onsetDatetime       DateTime?
  onsetAgeValue       Float?
  onsetAgeComparator  String?
  onsetAgeUnit        String?
  onsetAgeSystem      String?
  onsetAgeCode        String?
  onsetPeriodStart    DateTime?
  onsetPeriodEnd      DateTime?
  onsetRangeLowValue  Float?
  onsetRangeLowUnit   String?
  onsetRangeHighValue Float?
  onsetRangeHighUnit  String?
  onsetString         String?

  // abatement[x]
  abatementDatetime       DateTime?
  abatementAgeValue       Float?
  abatementAgeComparator  String?
  abatementAgeUnit        String?
  abatementAgeSystem      String?
  abatementAgeCode        String?
  abatementPeriodStart    DateTime?
  abatementPeriodEnd      DateTime?
  abatementRangeLowValue  Float?
  abatementRangeLowUnit   String?
  abatementRangeHighValue Float?
  abatementRangeHighUnit  String?
  abatementString         String?

  recordedDate DateTime?

  // recorder (Reference)
  recorderType    String?
  recorderId      Int?
  recorderDisplay String?

  // asserter (Reference)
  asserterType    String?
  asserterId      Int?
  asserterDisplay String?

  isDoctorAccepted Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifiers ConditionIdentifier[]
  categories  ConditionCategory[]
  bodySites   ConditionBodySite[]
  stages      ConditionStage[]
  evidence    ConditionEvidence[]
  notes       ConditionNote[]

  @@index([orgId, appointmentId])
}

model ConditionIdentifier {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  use         String?
  typeSystem  String?
  typeCode    String?
  typeDisplay String?
  typeText    String?
  system      String?
  value       String
  periodStart DateTime?
  periodEnd   DateTime?
  assigner    String?

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ConditionCategory {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  codingSystem  String?
  codingCode    String?
  codingDisplay String?
  text          String?

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ConditionBodySite {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  codingSystem  String?
  codingCode    String?
  codingDisplay String?
  text          String?

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ConditionStage {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  // summary (CodeableConcept)
  summarySystem  String?
  summaryCode    String?
  summaryDisplay String?
  summaryText    String?

  // type (CodeableConcept)
  typeSystem  String?
  typeCode    String?
  typeDisplay String?
  typeText    String?

  condition   Condition                  @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  assessments ConditionStageAssessment[]

  @@index([conditionId])
}

model ConditionStageAssessment {
  id      Int     @id @default(autoincrement())
  stageId Int
  orgId   String?

  referenceType    String?
  referenceId      Int?
  referenceDisplay String?

  stage ConditionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model ConditionEvidence {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  condition Condition                 @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  codes     ConditionEvidenceCode[]
  details   ConditionEvidenceDetail[]

  @@index([conditionId])
}

model ConditionEvidenceCode {
  id         Int     @id @default(autoincrement())
  evidenceId Int
  orgId      String?

  codingSystem  String?
  codingCode    String?
  codingDisplay String?
  text          String?

  evidence ConditionEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
}

model ConditionEvidenceDetail {
  id         Int     @id @default(autoincrement())
  evidenceId Int
  orgId      String?

  referenceType    String?
  referenceId      Int?
  referenceDisplay String?

  evidence ConditionEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
}

model ConditionNote {
  id          Int     @id @default(autoincrement())
  conditionId String
  orgId       String?

  text                   String
  time                   DateTime?
  authorString           String?
  authorReferenceType    String?
  authorReferenceId      Int?
  authorReferenceDisplay String?

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}
